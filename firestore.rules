rules_version = '2';

// UNIVERSUM - Regole Firestore (Spark)
// Limite server: max 3 per account, conteggio salvato in users/{uid}.serverIds
// NOTA: file da pubblicare con `firebase deploy --only firestore:rules`.
// Il controllo applicativo resta anche nella funzione di join (claimServerSlot).
//
// HARDENING 22/11/2026: flotte modificabili solo da attaccante/difensore,
// partenza con proprieta' della base, vincolo di provenienza per conquiste,
// NPC raid confinati ai pianeti del richiedente, rapporti privati.
// IMPORTANTE: il motore resta client-side; regole Firestore NON verificano
// calcolo risorse, esito combattimenti e accrediti. Si veda documents/audit sicurezza online.txt.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function myUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function myServerIds() {
      return (exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && 'serverIds' in myUserDoc().data)
        ? myUserDoc().data.serverIds
        : [];
    }

    function underServerLimit(uniId) {
      return myServerIds().size() < 3 || uniId in myServerIds();
    }

    function isFounder(uniId) {
      return exists(/databases/$(database)/documents/online_universes/$(uniId))
        && (
          get(/databases/$(database)/documents/online_universes/$(uniId)).data.founderUid == request.auth.uid
          || get(/databases/$(database)/documents/online_universes/$(uniId)).data.ownerUid == request.auth.uid
        );
    }

    function oldPlayerCount() {
      return ('playerCount' in resource.data) ? resource.data.playerCount : 0;
    }

    // Campi di un pianeta che un NON proprietario può modificare (risoluzione flotte, assedi,
    // conquista, inbox di variazioni, detriti).
    function planetFieldsForOthers() {
      return ['inbox', 'debris', 'embargo', 'occupation', 'moon',
        'ownerUid', 'ownerName', 'isNpc',
        'botLevel', 'botPersonality', 'botCreatedAt', 'growthEnabled',
        'resources', 'fleet', 'defenses', 'mothershipHangars',
        'buildQueue', 'shipyardQueue', 'defenseQueue', 'lastUpdated', 'lastResolutionFleetId','services'];
    }

    // P-R3: campi di una flotta che chiunque autenticato può modificare (risoluzione lato client).
    // NON include attackerUid, attackerName, attackerTech, defenderUid, targetCoords, originCoords,
    // targetKey, cargo (immutabile durante la risoluzione), ransom, schemaVersion.
    // Include 'mission' perché recallOnlineFleet imposta mission='recall'.
    // Include 'schemaVersion' perché migrateOnlineFleets aggiorna lo schema.
    function fleetFieldsForUpdate() {
      return ['status', 'phase', 'resolved', 'completedAt',
        'ships', 'fleet', 'cargo', 'galatticaReturn', 'galReturnCoords', 'fallbackPlanetKey',
        'arrivalTime', 'returnTime',
        'siegeDeuterium', 'lastSiegeTickAt', 'siegeStartedAt',
        'pendingRansom', 'repaired', 'repairReason',
        'mission', 'schemaVersion', 'departureTime', 'carrierHangars', 'crepuscoloDamaged',
        // Solo per correggere i due orari al timestamp di partenza Firebase.
        'zoneArrivalTime', 'explorationEndTime'];
    }

    // Mantiene coerenti gli istanti di una spedizione corretti sul timestamp
    // Firebase; non autorizza modifiche arbitrarie alle durate immutabili.
    function validExplorationClockCorrection() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['zoneArrivalTime', 'explorationEndTime'])
        || (
          request.auth.uid == resource.data.attackerUid
          && resource.data.status == 'outbound'
          && request.resource.data.status == 'outbound'
          && resource.data.mission == 'expedition'
          && request.resource.data.mission == resource.data.mission
          && request.resource.data.travelDurationMs == resource.data.travelDurationMs
          && request.resource.data.explorationHoldMs == resource.data.explorationHoldMs
          && request.resource.data.returnTravelDurationMs == resource.data.returnTravelDurationMs
          && request.resource.data.zoneArrivalTime ==
            request.resource.data.departureTime + resource.data.travelDurationMs
          && request.resource.data.explorationEndTime ==
            request.resource.data.zoneArrivalTime + resource.data.explorationHoldMs
          && request.resource.data.arrivalTime == request.resource.data.explorationEndTime
          && request.resource.data.returnTime ==
            request.resource.data.explorationEndTime + resource.data.returnTravelDurationMs
        );
    }

    // Un client che non partecipa allo scontro non puo' modificare le flotte.
    // La risoluzione rimane client-side: NON e' una prova di risultato di combattimento.
    function fleetParty() {
      return resource.data.attackerUid == request.auth.uid
        || resource.data.defenderUid == request.auth.uid;
    }

    function validOwnerCheckpoint(uniId) {
      let changed=request.resource.data.diff(resource.data).affectedKeys();
      let protectedOrigin=('ordinaryDispatchId' in resource.data)
        && resource.data.ordinaryDispatchId==request.resource.data.get('ordinaryDispatchId','')
        && resource.data.get('isNpc',false)==false;
      // A settled receipt never makes an old, unversioned stock checkpoint valid.
      // Inbox credits and other non-checkpoint updates retain the legacy path.
      return ((!protectedOrigin && (!('serviceRevision' in resource.data)
          || !changed.hasAny(['lastUpdated','serviceRevision'])))
        || (protectedOrigin && !changed.hasAny(['lastUpdated','serviceRevision','resources','fleet','defenses','mothershipHangars','buildQueue','shipyardQueue','defenseQueue','services','bacinoSpaziale'])))
        || (request.resource.data.serviceRevision == getAfter(/databases/$(database)/documents/online_universes/$(uniId)/players/$(request.auth.uid)).data.serviceRevision
          && request.resource.data.serviceRevision == get(/databases/$(database)/documents/online_universes/$(uniId)/players/$(request.auth.uid)).data.get('serviceRevision',0) + 1);
    }

    // AT05: terminal evidence is independent of the lifetime of the fleet/profile.
    function opPath(uniId, opId) {
      return /databases/$(database)/documents/online_universes/$(uniId)/ordinaryDispatchOps/$(opId);
    }
    function pilotPath(uniId, uid) {
      return /databases/$(database)/documents/online_universes/$(uniId)/players/$(uid);
    }
    function flightPath(uniId, opId) {
      return /databases/$(database)/documents/online_universes/$(uniId)/fleets/$(opId);
    }
    function originPath(uniId, key) {
      return /databases/$(database)/documents/online_universes/$(uniId)/planets/$(key);
    }
    function ordinaryHumanFleet(d) {
      return !('originGalatticaKey' in d)
        && !('targetGalatticaId' in d)
        && !d.ships.keys().hasAny(['hephaestusForge','prometheusOracle','invictus','crepuscolo'])
        && d.get('carrierHangars', []).size() == 0;
    }
    // Reject empty/mislabelled exemptions, preserve the original special paths.
    function validSpecialDispatch(uniId, d) {
      return ('originGalatticaKey' in d)
        || (d.get('targetGalatticaId', '') is string && d.get('targetGalatticaId', '') != ''
          && d.mission == 'destroyMoon' && d.ships.get('deathStar',0) > 0
          && get(/databases/$(database)/documents/online_universes/$(uniId)/galatticheMap/$(d.targetGalatticaId)).data.ownerUid == d.defenderUid
          && d.defenderUid != request.auth.uid
          && get(/databases/$(database)/documents/online_universes/$(uniId)/galatticheMap/$(d.targetGalatticaId)).data.coordKey == d.targetKey)
        || d.ships.get('hephaestusForge',0) > 0 || d.ships.get('prometheusOracle',0) > 0
        || (('originPlanetId' in d) && ('birthBacinoAt' in d)
          && (d.ships.get('invictus',0)>0 || d.ships.get('crepuscolo',0)>0)
          && get(originPath(uniId,d.originKey)).data.id == d.originPlanetId
          && get(originPath(uniId,d.originKey)).data.bacinoSpaziale.status=='active'
          && getAfter(originPath(uniId,d.originKey)).data.bacinoSpaziale!=get(originPath(uniId,d.originKey)).data.bacinoSpaziale)
        || (d.ships.get('mothership',0)>0 && d.get('carrierHangars',[]).size()==d.ships.mothership);
    }
    function validTerminalShape(r, before, after) {
      return r is map && r.keys().hasOnly(['operationId','originKey','expectedRevision','terminalRevision','profileJoinedAt','profileCreatedAt','status','acknowledged'])
        && r.operationId is string && r.operationId.size()>0 && r.originKey is string
        && r.profileJoinedAt == before.get('joinedAt',null)
        && r.get('profileCreatedAt',null) == before.get('at05ProfileCreatedAt',null)
        && r.acknowledged == false && r.status in ['committed','cancelled']
        && (r.status!='cancelled' || after.diff(before).affectedKeys().hasOnly(['serviceRevision','ordinaryDispatchReceipt']))
        && ((r.expectedRevision is int && r.expectedRevision>=0 && r.expectedRevision<9007199254740991
          && r.expectedRevision==before.get('serviceRevision',0)
          && r.terminalRevision==r.expectedRevision+1 && after.serviceRevision==r.terminalRevision)
          || (r.status=='committed' && r.expectedRevision==null && r.terminalRevision==null
            && !('serviceRevision' in before) && !('serviceRevision' in after)
            && before.get('ordinaryDispatchReceipt',null)==null));
    }
    function nonnegative(n) { return n<0 ? 0 : n; }
    function shipDebited(q, balance, available) {
      return q is int && q>0 && balance>=0 && balance+q<=available;
    }
    function resourceDebited(after,proof,id) {
      return proof.resourcesBefore[id] is int && proof.resourcesDebit[id] is int && proof.resourcesDebit[id]>=0
        && after.resources[id]==nonnegative(proof.resourcesBefore[id]-proof.resourcesDebit[id]);
    }
    function validDebitProof(f,proof,before,after) {
      let ships=f.ships;
      let stock=before.fleet;
      let inbox=before.get('inbox',{}).get('fleet',{});
      let final=after.fleet;
      let projected=proof.shipsBefore;
      let queued=before.get('shipyardQueue',[]).size()>0;
      return proof.keys().hasOnly(['shipsBefore','resourcesBefore','resourcesDebit'])
        && ships.size()>0 && ships.keys().hasOnly(['smallCargo','largeCargo','lightFighter','heavyFighter','cruiser','battleship','bomber','battlecruiser','colonyShip','recycler','espionageProbe','mothership','deathStar'])
        && proof.shipsBefore.keys()==ships.keys()
        && proof.resourcesDebit.keys().hasOnly(['metal','crystal','deuterium'])
        && proof.resourcesBefore.keys().hasOnly(['metal','crystal','deuterium'])
        && proof.resourcesDebit.metal==f.cargo.metal && proof.resourcesDebit.crystal==f.cargo.crystal
        && proof.resourcesDebit.deuterium>=f.cargo.deuterium+1+(f.mission=='expedition' && f.get('blackHole',false) ? 50000 : 0)
        && resourceDebited(after,proof,'metal') && resourceDebited(after,proof,'crystal') && resourceDebited(after,proof,'deuterium')
        && (!('smallCargo' in ships) || shipDebited(ships.smallCargo,final.smallCargo,queued ? projected.smallCargo : stock.get('smallCargo',0)+inbox.get('smallCargo',0)))
        && (!('largeCargo' in ships) || shipDebited(ships.largeCargo,final.largeCargo,queued ? projected.largeCargo : stock.get('largeCargo',0)+inbox.get('largeCargo',0)))
        && (!('lightFighter' in ships) || shipDebited(ships.lightFighter,final.lightFighter,queued ? projected.lightFighter : stock.get('lightFighter',0)+inbox.get('lightFighter',0)))
        && (!('heavyFighter' in ships) || shipDebited(ships.heavyFighter,final.heavyFighter,queued ? projected.heavyFighter : stock.get('heavyFighter',0)+inbox.get('heavyFighter',0)))
        && (!('cruiser' in ships) || shipDebited(ships.cruiser,final.cruiser,queued ? projected.cruiser : stock.get('cruiser',0)+inbox.get('cruiser',0)))
        && (!('battleship' in ships) || shipDebited(ships.battleship,final.battleship,queued ? projected.battleship : stock.get('battleship',0)+inbox.get('battleship',0)));
    }
    function remainingShipDebits(uniId, opId, before, after) {
      let proof=getAfter(opPath(uniId,opId)).data.proof;
      let ships=getAfter(flightPath(uniId,opId)).data.ships;
      let stock=before.fleet;
      let inbox=before.get('inbox',{}).get('fleet',{});
      let final=after.fleet;
      let projected=proof.shipsBefore;
      let queued=before.get('shipyardQueue',[]).size()>0;
      return (!('bomber' in ships) || shipDebited(ships.bomber,final.bomber,queued ? projected.bomber : stock.get('bomber',0)+inbox.get('bomber',0)))
        && (!('battlecruiser' in ships) || shipDebited(ships.battlecruiser,final.battlecruiser,queued ? projected.battlecruiser : stock.get('battlecruiser',0)+inbox.get('battlecruiser',0)))
        && (!('colonyShip' in ships) || shipDebited(ships.colonyShip,final.colonyShip,queued ? projected.colonyShip : stock.get('colonyShip',0)+inbox.get('colonyShip',0)))
        && (!('recycler' in ships) || shipDebited(ships.recycler,final.recycler,queued ? projected.recycler : stock.get('recycler',0)+inbox.get('recycler',0)))
        && (!('espionageProbe' in ships) || shipDebited(ships.espionageProbe,final.espionageProbe,queued ? projected.espionageProbe : stock.get('espionageProbe',0)+inbox.get('espionageProbe',0)))
        && (!('mothership' in ships) || shipDebited(ships.mothership,final.mothership,queued ? projected.mothership : stock.get('mothership',0)+inbox.get('mothership',0)))
        && (!('deathStar' in ships) || shipDebited(ships.deathStar,final.deathStar,queued ? projected.deathStar : stock.get('deathStar',0)+inbox.get('deathStar',0)));
    }
    function originCheckpointMatches(uniId, r, uid, f, proof) {
      let p=originPath(uniId,r.originKey);
      let before=get(p).data;
      let after=getAfter(p).data;
      return before.ownerUid==uid && after.ownerUid==uid
        && after.ordinaryDispatchId==r.operationId && before.get('ordinaryDispatchId','')!=r.operationId
        && (r.terminalRevision==null || after.serviceRevision==r.terminalRevision)
        && validDebitProof(f,proof,before,after);
    }
    function terminalEffects(uniId, r, uid, proof) {
      let f=flightPath(uniId,r.operationId);
      let origin=originPath(uniId,r.originKey);
      return !exists(f) && (r.status=='cancelled' ? (!existsAfter(f)
          && exists(origin)==existsAfter(origin) && (!exists(origin) || get(origin).data==getAfter(origin).data))
        : (existsAfter(f) && getAfter(f).data.attackerUid==uid
          && getAfter(f).data.originKey==r.originKey && ordinaryHumanFleet(getAfter(f).data)
          && originCheckpointMatches(uniId,r,uid,getAfter(f).data,proof)));
    }
    function newTerminal(uniId, uid, before, after, r) {
      let op=opPath(uniId,r.operationId);
      return !exists(op) && getAfter(op).data.receipt==r;
    }
    function validReceiptTransition(uniId, uid) {
      let before=resource.data;
      let after=request.resource.data;
      let old=before.get('ordinaryDispatchReceipt',null);
      let next=after.get('ordinaryDispatchReceipt',null);
      return after.get('at05ProfileCreatedAt',null)==before.get('at05ProfileCreatedAt',null)
        && after.get('joinedAt',null)==before.get('joinedAt',null)
        && ((old==next && (old==null || (old.acknowledged==true && after.get('serviceRevision',-1) is int && after.serviceRevision>0) || after.diff(before).affectedKeys().hasOnly(['lastSeen','nickname'])))
          || (next is map && (old==null || (old.acknowledged==true && old.operationId!=next.operationId))
            && newTerminal(uniId,uid,before,after,next)));
    }
    function validReceiptAck() {
      let old=resource.data.get('ordinaryDispatchReceipt',null);
      let next=request.resource.data.get('ordinaryDispatchReceipt',null);
      return old is map && next is map && old.acknowledged==false && next.acknowledged==true
        && next.diff(old).affectedKeys().hasOnly(['acknowledged'])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ordinaryDispatchReceipt']);
    }
    function validOriginStamp(uniId, planetId) {
      let old=resource.data.get('ordinaryDispatchId','');
      let next=request.resource.data.get('ordinaryDispatchId','');
      return old==next || (next is string && next!=''
        && !exists(opPath(uniId,next)) && existsAfter(opPath(uniId,next))
        && getAfter(opPath(uniId,next)).data.uid==request.auth.uid
        && getAfter(opPath(uniId,next)).data.receipt.originKey==planetId
        && getAfter(opPath(uniId,next)).data.receipt.status=='committed'
        && remainingShipDebits(uniId,next,resource.data,request.resource.data));
    }
    function validOrdinaryCreate(uniId, fleetId) {
      let op=getAfter(opPath(uniId,fleetId)).data;
      return op.uid==request.auth.uid && op.receipt.status=='committed';
    }
    function validOperationCreate(uniId, operationId) {
      let d=request.resource.data;
      let p=pilotPath(uniId,request.auth.uid);
      let before=get(p).data;
      let after=getAfter(p).data;
      let old=before.get('ordinaryDispatchReceipt',null);
      return d.keys().hasOnly(['uid','receipt','proof']) && d.uid==request.auth.uid
        && (d.receipt.status=='committed' ? d.proof is map : !('proof' in d))
        && d.receipt.operationId==operationId && after.ordinaryDispatchReceipt==d.receipt
        && (old==null || (old.acknowledged==true && old.operationId!=operationId))
        && validTerminalShape(d.receipt,before,after) && terminalEffects(uniId,d.receipt,request.auth.uid,d.get('proof',{}));
    }

    function validHumanFleetCreate(uniId) {
      return request.resource.data.attackerUid == request.auth.uid
        && request.resource.data.originCoords is map
        && request.resource.data.targetCoords is map
        && request.resource.data.targetKey is string
        && request.resource.data.ships is map
        && (!request.resource.data.ships.keys().hasAny(['hephaestusForge','prometheusOracle'])
          || (request.resource.data.mission in ['deploy','transport']
            && request.resource.data.targetKey != request.resource.data.originKey
            && get(/databases/$(database)/documents/online_universes/$(uniId)/planets/$(request.resource.data.targetKey)).data.ownerUid == request.auth.uid))
        && request.resource.data.cargo is map
        && request.resource.data.mission in [
          'attack', 'destroyMoon', 'spy', 'transport', 'deploy', 'colonize',
          'recycle', 'expedition', 'embargo', 'blockade', 'occupy', 'incursion'
        ]
        && (request.resource.data.mission != 'incursion' || (
          request.resource.data.ships.keys().hasOnly(['mothership'])
          && request.resource.data.ships.mothership is int
          && request.resource.data.ships.mothership > 0
          && request.resource.data.carrierHangars is list
          && request.resource.data.carrierHangars.size() == request.resource.data.ships.mothership
          && request.resource.data.targetKey != request.resource.data.originKey
          && exists(/databases/$(database)/documents/online_universes/$(uniId)/planets/$(request.resource.data.targetKey))
          && get(/databases/$(database)/documents/online_universes/$(uniId)/planets/$(request.resource.data.targetKey)).data.ownerUid != request.auth.uid
          && getAfter(/databases/$(database)/documents/online_universes/$(uniId)/planets/$(request.resource.data.originKey)).data.fleet.mothership ==
            get(/databases/$(database)/documents/online_universes/$(uniId)/planets/$(request.resource.data.originKey)).data.fleet.mothership - request.resource.data.ships.mothership
        ))
        && request.resource.data.status == 'outbound'
        && request.resource.data.resolved == false
        && request.resource.data.arrivalTime is number
        && request.resource.data.departureTime is number
        && request.resource.data.arrivalTime > request.resource.data.departureTime
        && request.resource.data.arrivalTime > request.time.toMillis()
        && request.resource.data.originKey is string
        && (('originGalatticaKey' in request.resource.data)
          ? (request.resource.data.originGalatticaKey == request.auth.uid + '~' + request.resource.data.originGalatticaId
            && !getAfter(/databases/$(database)/documents/online_universes/$(uniId)/galattiche/$(request.resource.data.originGalatticaKey)).data.destroyed
            && (getAfter(/databases/$(database)/documents/online_universes/$(uniId)/galattiche/$(request.resource.data.originGalatticaKey)).data.coordKey == request.resource.data.originKey
              || (request.resource.data.mission == 'deploy' && request.resource.data.defenderUid == request.auth.uid
                && get(/databases/$(database)/documents/online_universes/$(uniId)/galattiche/$(request.resource.data.originGalatticaKey)).data.coordKey == request.resource.data.originKey
                && get(/databases/$(database)/documents/online_universes/$(uniId)/planets/$(request.resource.data.targetKey)).data.ownerUid == request.auth.uid))
            && getAfter(/databases/$(database)/documents/online_universes/$(uniId)/galattiche/$(request.resource.data.originGalatticaKey)).data.ownerUid == request.auth.uid)
          : (exists(/databases/$(database)/documents/online_universes/$(uniId)/planets/$(request.resource.data.originKey))
        && get(/databases/$(database)/documents/online_universes/$(uniId)/planets/$(request.resource.data.originKey)).data.ownerUid == request.auth.uid));
    }

    function validNpcRaidCreate(uniId, fleetId) {
      return fleetId.matches('^npc_raid_' + request.auth.uid + '_[0-9]+$')
        && request.resource.data.attackerUid is string
        && request.resource.data.attackerUid.matches('^npc_raid_.*')
        && request.resource.data.defenderUid == request.auth.uid
        && request.resource.data.mission == 'attack'
        && request.resource.data.status == 'outbound'
        && request.resource.data.resolved == false
        && request.resource.data.targetKey is string
        && exists(/databases/$(database)/documents/online_universes/$(uniId)/planets/$(request.resource.data.targetKey))
        && get(/databases/$(database)/documents/online_universes/$(uniId)/planets/$(request.resource.data.targetKey)).data.ownerUid == request.auth.uid;
    }

    // La conquista deve almeno essere collegata a una flotta d'attacco
    // reale, diretta su QUESTO pianeta e gia' arrivata.
    function hasArrivalEvidence(uniId, planetId) {
      return request.resource.data.lastResolutionFleetId is string
        && exists(/databases/$(database)/documents/online_universes/$(uniId)/fleets/$(request.resource.data.lastResolutionFleetId))
        && get(/databases/$(database)/documents/online_universes/$(uniId)/fleets/$(request.resource.data.lastResolutionFleetId)).data.attackerUid == request.auth.uid
        && get(/databases/$(database)/documents/online_universes/$(uniId)/fleets/$(request.resource.data.lastResolutionFleetId)).data.targetKey == planetId
        && get(/databases/$(database)/documents/online_universes/$(uniId)/fleets/$(request.resource.data.lastResolutionFleetId)).data.mission == 'attack'
        && get(/databases/$(database)/documents/online_universes/$(uniId)/fleets/$(request.resource.data.lastResolutionFleetId)).data.arrivalTime <= request.time.toMillis();
    }

    // P-R5: validazione schema per un messaggio di rapporto (messages)
    function validReport() {
      return request.resource.data.recipientUid is string
        && request.resource.data.recipientUid.size() > 0
        && request.resource.data.title is string
        && request.resource.data.body is string;
    }

    function isChatParticipant(chatId) {
      return request.auth.uid in chatId.split('_');
    }

    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && (!('serverIds' in request.resource.data) || request.resource.data.serverIds.size() <= 3)
        && (!('serverCount' in request.resource.data) || request.resource.data.serverCount <= 3);
      allow delete: if false;
    }

    match /online_universes/{uniId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && (request.resource.data.founderUid == request.auth.uid
          || request.resource.data.ownerUid == request.auth.uid)
        && underServerLimit(uniId);
      allow update: if signedIn()
        && (
          isFounder(uniId)
          || (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['playerCount'])
            && request.resource.data.playerCount is number
            && request.resource.data.playerCount >= 0
            && request.resource.data.playerCount - oldPlayerCount() <= 1
            && oldPlayerCount() - request.resource.data.playerCount <= 1
          )
        );
      allow delete: if signedIn() && isFounder(uniId);

      match /players/{playerId} {
        allow read: if signedIn();
        allow create: if signedIn() && request.auth.uid == playerId && underServerLimit(uniId)
          && request.resource.data.at05ProfileCreatedAt == request.time && request.resource.data.joinedAt is int
          && !('ordinaryDispatchReceipt' in request.resource.data);
        allow update: if signedIn() && request.auth.uid == playerId
          && (validReceiptAck() || ((!('serviceRevision' in resource.data) ||
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastSeen','nickname']) ||
            request.resource.data.serviceRevision == resource.data.serviceRevision + 1)
          && validReceiptTransition(uniId,playerId)));
        allow delete: if signedIn() && request.auth.uid == playerId
          && (resource.data.get('ordinaryDispatchReceipt',null)==null || resource.data.ordinaryDispatchReceipt.acknowledged==true);
      }

      match /ordinaryDispatchOps/{operationId} {
        allow get: if signedIn() && (resource==null || resource.data.uid==request.auth.uid);
        allow list: if false;
        allow create: if signedIn() && validOperationCreate(uniId,operationId);
        allow update, delete: if false;
      }

      match /planets/{planetId} {
        allow read: if signedIn();
        allow create: if signedIn() && !('ordinaryDispatchId' in request.resource.data) && (
          request.resource.data.ownerUid == request.auth.uid
          || (request.resource.data.isNpc == true && isFounder(uniId))
          || (request.resource.data.isNpc == true
            && request.resource.data.ownerUid == null
            && exists(/databases/$(database)/documents/online_universes/$(uniId))
            && 'botConfig' in get(/databases/$(database)/documents/online_universes/$(uniId)).data)
        );
        allow update: if signedIn()
          && (
            (resource.data.ownerUid == request.auth.uid && validOwnerCheckpoint(uniId) && validOriginStamp(uniId,planetId))
            || (resource.data.ownerUid != request.auth.uid
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(planetFieldsForOthers())
              && (request.resource.data.get('inbox', {}).get('dockReturns', {}) == resource.data.get('inbox', {}).get('dockReturns', {})
                || (request.resource.data.ownerUid == request.auth.uid && hasArrivalEvidence(uniId, planetId)))
              // Hangar del giocatore sono modificabili solo dal proprietario:
              // i combattimenti esterni registrano gli ID persi nell'inbox.
              && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['mothershipHangars'])
                || resource.data.isNpc == true
                || request.resource.data.ownerUid != resource.data.ownerUid)
              && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['services'])
                || (request.resource.data.ownerUid != resource.data.ownerUid && !('services' in request.resource.data)))
              && (
                request.resource.data.ownerUid == resource.data.ownerUid
                || (request.resource.data.ownerUid == request.auth.uid
                    && hasArrivalEvidence(uniId, planetId))
              )
            )
          );
        allow delete: if signedIn()
          && (resource.data.ownerUid == request.auth.uid || isFounder(uniId));
      }

      // Supremas staging: only the callable may change either document.
      // Access to the private battle and its receipts is denied to all browsers.
      match /supremaRecoveryPublic/{siegeId} {
        allow read: if signedIn() && request.auth.uid in resource.data.participants;
        allow write: if false;
      }

      match /supremaRecoveryPrivate/{document=**} {
        allow read, write: if false;
      }

      function validGalStrike(galId) {
        let path=/databases/$(database)/documents/online_universes/$(uniId)/fleets/$(request.resource.data.destroyedBy);
        let f=get(path).data;
        return signedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['destroyed','destroyedBy'])
          && request.resource.data.destroyed && !resource.data.destroyed && f.defenderUid == resource.data.ownerUid
          && f.attackerUid != f.defenderUid && request.auth.uid in [f.attackerUid,f.defenderUid]
          && f.targetGalatticaId == galId && f.targetKey == resource.data.coordKey
          && f.mission == 'destroyMoon' && f.status == 'outbound' && !f.resolved && f.ships.deathStar > 0
          && f.arrivalTime <= request.time.toMillis() && getAfter(path).data.status == 'returning';
      }
      match /galatticheMap/{galId} {
        function validMarker() {
          let g=getAfter(/databases/$(database)/documents/online_universes/$(uniId)/galattiche/$(galId)).data;
          let d=request.resource.data;
          return signedIn() && g.ownerUid == request.auth.uid && d.ownerUid == g.ownerUid
            && d.keys().hasOnly(['ownerUid','ownerName','name','coordKey','systemKey','defenses','destroyed'])
            && d.coordKey == g.coordKey && d.systemKey == g.systemKey && d.destroyed == g.destroyed
            && d.defenses == g.state.get('defenses',{});
        }
        allow read: if signedIn();
        allow create, update: if validMarker();
        allow update: if validGalStrike(galId)
          && getAfter(/databases/$(database)/documents/online_universes/$(uniId)/galattiche/$(galId)).data.destroyed;
      }
      match /galattiche/{galId} {
        allow get: if signedIn() && (resource == null || resource.data.ownerUid == request.auth.uid);
        allow list: if signedIn() && resource.data.ownerUid == request.auth.uid;
        function ownGalattica() {
          let d=request.resource.data;
          return signedIn() && d.ownerUid == request.auth.uid && galId == d.ownerUid+'~'+d.state.id
            && d.coordKey == string(d.state.coords.g)+'_'+string(d.state.coords.s)+'_'+string(d.state.coords.p);
        }
        allow update: if validGalStrike(galId)
          && getAfter(/databases/$(database)/documents/online_universes/$(uniId)/galatticheMap/$(galId)).data.destroyed;
        allow create: if ownGalattica() && request.resource.data.version == 1;
        allow update: if ownGalattica() && resource.data.ownerUid == request.auth.uid && !resource.data.destroyed
          && request.resource.data.version == resource.data.version+1;
      }

      match /fleets/{fleetId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && !exists(opPath(uniId,fleetId))
          && ((validHumanFleetCreate(uniId) && (ordinaryHumanFleet(request.resource.data)
            ? validOrdinaryCreate(uniId,fleetId) : validSpecialDispatch(uniId,request.resource.data)))
            || validNpcRaidCreate(uniId, fleetId));
        // P-R3: aggiornamento consentito a chiunque autenticato, MA solo sui campi di risoluzione.
        // Questo impedisce a un client malevolo di cambiare attackerUid, targetCoords, originCoords,
        // o di riscrivere ships/cargo con valori inventati durante il volo.
        allow update: if signedIn() && fleetParty()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(fleetFieldsForUpdate())
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['crepuscoloDamaged'])
            || (resource.data.status == 'outbound' && request.resource.data.status in ['returning','embargo','occupy']
              && resource.data.ships.crepuscolo == 1 && request.resource.data.crepuscoloDamaged == true))
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['galatticaReturn','galReturnCoords','fallbackPlanetKey'])
            || ('originGalatticaKey' in resource.data && resource.data.attackerUid == request.auth.uid
              && resource.data.status == 'returning' && request.resource.data.status == 'returning'
              && resource.data.returnTime <= request.time.toMillis()))
          && validExplorationClockCorrection()
          && (
            request.resource.data.mission == resource.data.mission
            || (resource.data.attackerUid == request.auth.uid
                && resource.data.status == 'outbound'
                && request.resource.data.mission == 'recall'
                && request.resource.data.status == 'returning')
          );
        allow delete: if signedIn()
          && (resource.data.attackerUid == request.auth.uid || isFounder(uniId));
      }

      match /messages/{messageId} {
        allow read: if signedIn()
          && resource.data.recipientUid == request.auth.uid;
        // P-R4: la creazione è aperta (la risoluzione genera rapporti per altri giocatori),
        // ma lo schema deve essere valido.
        allow create: if signedIn() && validReport();
        allow update: if false;
        allow delete: if signedIn()
          && resource.data.recipientUid == request.auth.uid;
      }

      match /chat/{messageId} {
        // P-R5: chiunque autenticato può leggere e creare, ma solo l'autore può eliminare.
        // Nessuno può modificare un messaggio esistente.
        allow read: if signedIn();
        allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
        allow update: if false;
        allow delete: if signedIn() && resource.data.uid == request.auth.uid;
      }

      match /private_chats/{chatId} {
        allow get: if signedIn() && (isChatParticipant(chatId) || isFounder(uniId));
        allow list: if signedIn()
          && (request.auth.uid in resource.data.participants || isFounder(uniId));
        allow create: if signedIn()
          && isChatParticipant(chatId)
          && request.auth.uid in request.resource.data.participants;
        allow update: if signedIn()
          && isChatParticipant(chatId)
          && request.auth.uid in request.resource.data.participants;
        allow delete: if signedIn() && (isChatParticipant(chatId) || isFounder(uniId));

        match /messages/{messageId} {
          allow read: if signedIn() && (isChatParticipant(chatId) || isFounder(uniId));
          allow create: if signedIn()
            && isChatParticipant(chatId)
            && request.resource.data.senderUid == request.auth.uid;
          allow update: if false;
          allow delete: if signedIn() && (isChatParticipant(chatId) || isFounder(uniId));
        }
      }
    }
  }
}